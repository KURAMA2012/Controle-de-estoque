# Copie para .env (cp .env.example .env) e preencha. NUNCA commite o .env.

# --- Banco (usado pelo Postgres do docker-compose e pela api) ---
DB_USER=estoque
DB_PASSWORD=troque-esta-senha
# Fora do compose, informe a URL JDBC (no compose ela e fixada para o servico "db")
# DB_URL=jdbc:postgresql://localhost:5432/estoque
# DATABASE_MAX_CONNECTION=10
# DATABASE_MIN_IDLE=2

# --- JWT (HS512) ---
# OBRIGATORIO, minimo 64 bytes. Gere com, por exemplo:
#   openssl rand -base64 64 | tr -d '\n'
#   PowerShell: [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-64-bytes
# Expiracao do token em ms (padrao 24h)
JWT_EXPIRATION=86400000

# --- Admin inicial (criado so se a tabela de usuarios estiver vazia) ---
APP_ADMIN_LOGIN=admin
APP_ADMIN_SENHA=troque-esta-senha

# --- Outros ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:4300
# ESTOQUE_PORT=7009
# LOG_FILE=
# ESTOQUE_IMAGEM_HOSTS_PERMITIDOS=
# JAVA_OPTS=-Xms256m -Xmx512m

# --- Front (estoque-web) - lidas pelo container web em runtime (config.js) ---
# API_URL=http://localhost:7009/api/estoque
# DEMO_LOGIN=      # se preenchido, a tela de login mostra o acesso demo
# DEMO_SENHA=
# --- Alternativa ao DB_URL (usada no Render) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=estoque
